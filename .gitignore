# ====================================================================
# MC-WebDashboard .gitignore
# Covers Java / Gradle, Fabric Loom (Minecraft), Node / Vite frontend,
# IDEs, and OS-specific files.
# ====================================================================

# --------------------------------------------------------------------
# Gradle & Java Build Output
# --------------------------------------------------------------------
.gradle/
build/
out/
bin/
*.class

# Keep Gradle Wrapper artifacts tracked in VCS
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# --------------------------------------------------------------------
# Minecraft & Fabric Loom Run/Test Environments
# --------------------------------------------------------------------
.fabric/
.loom/
run/
run-server/
run-client/
*.mappings
crash-reports/
logs/
world/
saves/
eula.txt
server.properties
banned-ips.json
banned-players.json
ops.json
usercache.json
usernamecache.json
session.lock

# --------------------------------------------------------------------
# Frontend Web Dashboard (Node.js / Vite / Tailwind)
# --------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# Environment variables & secrets
.env
.env.*
!.env.example

# Package manager logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.eslintcache
.stylelintcache

# Generated frontend bundle copied into mod resources during build
/mod-core/src/main/resources/public/

# --------------------------------------------------------------------
# IDE & Code Editor Configurations
# --------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.project
.classpath
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# --------------------------------------------------------------------
# Operating System Files
# --------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
