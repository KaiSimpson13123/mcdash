{
  "schemaVersion": 1,
  "id": "mc-webdashboard",
  "version": "${version}",
  "name": "MC-WebDashboard",
  "description": "Production-grade Minecraft server administration dashboard embedded into Fabric.",
  "authors": [
    "Antigravity"
  ],
  "contact": {
    "homepage": "https://github.com/example/mc-webdashboard",
    "sources": "https://github.com/example/mc-webdashboard"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": [
      "net.mcwebdashboard.MCWebDashboardMod"
    ]
  },
  "mixins": [
    "mc-webdashboard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "luckperms": ">=5.4.0"
  }
}
